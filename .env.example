# Local development
# Switch to production when deploying to AWS
APP_ENV=development

# Bot token from Discord Developer Portal → Bot → Reset Token
DISCORD_TOKEN=

# Local Redis only (self-hosted via docker compose or redis://127.0.0.1:6379/0 for go run).
# Production uses Upstash — set /prod/discord/redis_url in AWS SSM (never commit that URL).
REDIS_URL=
